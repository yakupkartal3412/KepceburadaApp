<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F17">

    <!-- WebView: Uygulamanın Kendisi -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 1. Üst Düzey Pürüzsüz İlk Açılış Ekranı (3D JCB Beko Loder) -->
    <RelativeLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F17"
        android:padding="24dp">

        <!-- Center 3D Machine Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Exact 3D Yellow JCB Beko Loder Image -->
            <ImageView
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:src="@drawable/splash_3d_excavator"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp"/>

            <!-- Premium Brand Typography -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MakineBul"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÜRKİYE İŞ MAKİNESİ PLATFORMU"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.16"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Bottom Corporate Version & Quality Tag -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:text="v2.0 • Kurumsal Sürüm"
            android:textColor="#475569"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:layout_marginBottom="24dp"/>

    </RelativeLayout>

</FrameLayout>
